{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HuDaGee",
  "version": "0.1.0",
  "identifier": "com.hudagee.account-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HuDaGee-v0.1.0",
        "width": 750,
        "height": 500,
        "minWidth": 750,
        "minHeight": 500,
        "visible": false,
        "backgroundColor": "#080b12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
